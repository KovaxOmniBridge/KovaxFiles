{
  "name": "kovax-files-desktop",
  "version": "1.0.0",
  "description": "Engenharia Documental 100% Local para Advocacia e Prefeituras",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prepare:tessdata": "npx tsx scripts/prepare_offline_tessdata.ts",
    "build": "npx tsx scripts/prepare_offline_tessdata.ts && tsc && vite build && npm run test:bundle",
    "preview": "vite preview",
    "test": "npm run test:pr",
    "test:pr": "npm run test:distribution && npx tsx scripts/run_pr_test_battery.ts",
    "test:release": "npx tsx tests/suites/desktop_packaged.test.ts",
    "test:load": "npx tsx tests/suites/performance_load.test.ts",
    "test:adversarial": "npx tsx tests/suites/adversarial.test.ts",
    "test:suite:build": "npx tsx tests/suites/build.test.ts",
    "test:suite:security": "npx tsx tests/suites/electron_security.test.ts",
    "test:suite:pdf": "npx tsx tests/suites/pdf.test.ts",
    "test:suite:lgpd": "npx tsx tests/suites/lgpd.test.ts",
    "test:suite:crypto": "npx tsx tests/suites/crypto.test.ts",
    "test:suite:docx": "npx tsx tests/suites/docx.test.ts",
    "test:suite:ocr": "npx tsx tests/suites/ocr.test.ts",
    "test:suite:pades": "npx tsx tests/suites/pades.test.ts",
    "test:suite:protocolo": "npx tsx tests/suites/protocolo.test.ts",
    "test:suite:acervo": "npx tsx tests/suites/acervo.test.ts",
    "test:unit": "npx tsx tests/unit/contracts_and_lifecycle.test.ts && npx tsx tests/unit/backup_and_recovery.test.ts",
    "test:security": "npx tsx tests/security/input_validation_and_ipc.test.ts && npx tsx tests/security/offline_network_guard.test.ts",
    "test:integration": "npx tsx tests/integration/core_services_integration.test.ts && npx tsx tests/integration/uniform_state_contracts.test.ts",
    "test:e2e": "npx tsx tests/e2e/e2e_workflow.test.ts && npx tsx tests/e2e/electron_window_ipc.test.ts",
    "test:offline-guard": "npx tsx tests/security/offline_network_guard.test.ts",
    "test:backup-recovery": "npx tsx tests/unit/backup_and_recovery.test.ts",
    "benchmark": "npx tsx scripts/benchmark_performance.ts",
    "test:arch": "npm run test:unit && npm run test:security && npm run test:integration && npm run test:e2e",
    "test:stress": "npx tsx scripts/stress_test_e2e.ts",
    "test:security-redaction": "npx tsx scripts/run_redaction_security_suite.ts",
    "test:path-security": "npx tsx scripts/test_path_validation_security.ts",
    "test:path-integration": "npx tsx scripts/test_path_security_integration.ts",
    "test:electron-security": "npx tsx scripts/test_electron_security_hardening.ts",
    "test:dist-security": "npx tsx scripts/verify_distribution_security.ts",
    "test:pdf-edge-cases": "npx tsx scripts/test_advanced_pdf_edge_cases.ts",
    "test:ocr-pipeline": "npx tsx scripts/test_scanned_pdf_ocr_pipeline.ts",
    "test:ocr-integrity": "npx tsx scripts/test_ocr_integrity_and_fallbacks.ts",
    "test:searchable-ocr": "npx tsx scripts/test_ocr_document_service.ts",
    "test:offline-ocr": "npx tsx scripts/test_offline_ocr_isolated.ts && electron --no-sandbox scripts/test_electron_offline_ocr.cjs",
    "test:pdf-encryption": "npx tsx scripts/test_pdf_encryption_security.ts",
    "test:pades-signature": "npx tsx scripts/test_pades_signature_suite.ts",
    "test:pades-trust": "npx tsx scripts/test_pades_trust_validation.ts",
    "test:legal-trust": "npx tsx scripts/test_legal_trust_and_isolation.ts",
    "test:docx-fidelity": "npx tsx scripts/test_docx_import_export_fidelity.ts",
    "test:court-filing": "npx tsx scripts/test_court_filing_pipeline.ts",
    "test:process-stamper": "npx tsx scripts/test_process_stamper_chancela_integrity.ts",
    "test:docx-export": "npx tsx scripts/test_docx_export_integrity.ts",
    "test:editor-export": "npx tsx scripts/test_editor_professional_export_suite.ts",
    "test:custom-persistence": "npx tsx scripts/test_custom_legal_persistence_suite.ts",
    "test:jurisprudence": "npx tsx scripts/test_jurisprudence_integrity.ts",
    "test:corpus-audit": "npx tsx scripts/test_auditable_legal_corpus.ts",
    "test:legal-provenance": "npx tsx scripts/test_legal_provenance_and_authenticity.ts",
    "capture:official-sources": "npx tsx scripts/capture_official_legal_sources.ts",
    "test:custody": "npx tsx scripts/capture_official_legal_sources.ts",
    "test:pdf-compression": "npx tsx scripts/test_pdf_compression_advanced.ts",
    "test:rich-pdf-export": "npx tsx scripts/test_editor_rich_pdf_export.ts",
    "test:batch-isolation": "npx tsx scripts/test_batch_redaction_isolation.ts",
    "test:reliable-redaction": "npx tsx scripts/test_reliable_redaction_workflow.ts",
    "test:detection-modes": "npx tsx scripts/test_detection_mode_behavior.ts",
    "test:raster-quality": "npx tsx scripts/test_raster_quality_criteria.ts",
    "test:distribution-prerequisites": "npx tsx scripts/verify_distribution_prerequisites.ts",
    "test:sandbox-isolation": "electron --no-sandbox scripts/test_runtime_sandbox_isolation.cjs",
    "test:release-operational": "npx tsx scripts/verify_distribution_prerequisites.ts",
    "package:dev:win": "npm run build && tsx scripts/package_distribution.ts --win --publish never --allow-unsigned-internal",
    "package:win": "npm run build && tsx scripts/package_distribution.ts --win --publish never --allow-unsigned-internal",
    "package:mac": "npm run build && tsx scripts/package_distribution.ts --mac --publish never --allow-unsigned-internal",
    "package:linux": "npm run build && tsx scripts/package_distribution.ts --linux --publish never --allow-unsigned-internal",
    "package:all": "npm run package:win && npm run package:mac && npm run package:linux",
    "package:release": "npm run build && tsx scripts/package_distribution.ts --win --config.win.forceCodeSigning=true --publish never",
    "package:release:win": "npm run build && tsx scripts/package_distribution.ts --win --config.win.forceCodeSigning=true --publish never",
    "package:release:mac": "npm run build && tsx scripts/package_distribution.ts --mac --config.mac.forceCodeSigning=true --publish never --config.dmg.sign=true",
    "package:release:all": "npm run package:release:win && npm run package:release:mac && npm run package:linux",
    "package:internal": "npm run build && tsx scripts/package_distribution.ts --publish never --allow-unsigned-internal",
    "test:distribution": "tsx tests/unit/distribution_gates.test.ts && tsx tests/unit/distribution_contract.test.ts && tsx tests/unit/distribution_workflows.test.ts && tsx tests/unit/distribution_installers.test.ts && tsx tests/unit/distribution_journey.test.ts && tsx tests/unit/distribution_pages.test.ts && tsx tests/unit/distribution_publication.test.ts",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "typecheck:tools:all": "tsc -p tsconfig.tools-audit.json",
    "test:installers": "tsx scripts/verify_packaged_installers.ts",
    "test:bundle": "tsx scripts/verify_distribution_bundle.ts",
    "test:journey": "tsx tests/suites/desktop_packaged.test.ts --journey",
    "test:journey:negative": "tsx tests/suites/desktop_packaged.test.ts --journey-negative",
    "release:prepare": "tsx scripts/prepare_release_publication.ts",
    "distribution:finalize": "tsx scripts/finalize_distribution.ts"
  },
  "keywords": [
    "pje",
    "tjsp",
    "trf",
    "prefeitura",
    "advocacia",
    "pdf-compressor",
    "tarjador-lgpd",
    "juntada-processo",
    "ocr-local",
    "offline"
  ],
  "author": "Kovax Files Desktop Team",
  "license": "MIT",
  "dependencies": {
    "@pdfsmaller/pdf-decrypt": "^1.0.1",
    "@pdfsmaller/pdf-encrypt": "^1.2.0",
    "@types/node-forge": "^1.3.14",
    "docx": "^9.11.0",
    "fflate": "^0.8.3",
    "lucide-react": "^0.344.0",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tesseract.js": "^5.0.4"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "electron": "^42.11.14",
    "electron-builder": "^24.13.3",
    "js-yaml": "^5.5.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "vite-plugin-electron": "^0.28.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.kovaxfiles.desktop",
    "productName": "KovaxFiles Desktop",
    "copyright": "Copyright © 2026 Kovax Files Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "KovaxOmniBridge",
      "repo": "KovaxFiles"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": true,
      "verifyUpdateCodeSignature": true
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": true,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "KovaxFiles Desktop",
      "differentialPackage": true,
      "artifactName": "${productName}-${version}-${os}-${arch}-setup.${ext}"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "portable": {
      "artifactName": "${productName}-${version}-${os}-${arch}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
